# ==============================================================================
# PASSGUARD 2.0 - POSTGRESQL DATABASE CONFIGURATION
# Compatible with Neon (neon.tech), Supabase (supabase.com), or any PostgreSQL instance
# ==============================================================================

# 1. Neon PostgreSQL Example:
# DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Supabase PostgreSQL Example:
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Replace with your actual Neon or Supabase connection string:
DATABASE_URL="postgresql://postgres:password@localhost:5432/passguard_db?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/passguard_db?schema=public"

# Session Cookie Secret (for signing cookies if needed)
AUTH_SECRET="passguard_super_secure_jwt_session_secret_2026_change_in_production"
